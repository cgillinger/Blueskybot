# Bluesky Credentials
BLUESKY_USERNAME=your_username@provider.com
BLUESKY_PASSWORD=your_secure_password

# Alt-text image descriptions (optional)
# Requires a Gemini API key — get one free at https://aistudio.google.com/apikey
ALT_TEXT_ENABLED=false
ALT_TEXT_LANGUAGE=sv
GEMINI_API_KEY=your_gemini_api_key
# Gemini model (default: gemini-3.5-flash). Change here if Google retires it.
# GEMINI_MODEL=gemini-3.5-flash

# Alt-text provider: gemini (default), openai or mistral
ALT_TEXT_PROVIDER=gemini
OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-4o-mini

# Backup provider, tried when the main one fails (optional, recommended).
# Mistral's free plan: https://console.mistral.ai — use a ministral-* model.
# ALT_TEXT_FALLBACK_PROVIDER=mistral
# MISTRAL_API_KEY=your_mistral_api_key
# MISTRAL_MODEL=ministral-14b-latest
